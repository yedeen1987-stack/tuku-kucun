# 复制成 .dev.vars（本地调试）或用 `npx wrangler secret put` 设到线上。
# 这两个都不要提交到 Git。

# 会话签名密钥。随便生成一串长随机字符串，例如：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 给以后的本地系统推送拣货单用（PUT /api/import）。至少 24 位。
# 现在用不到可以先空着，空着就等于关闭这个接口。
IMPORT_TOKEN=

# 库存图记（图库）的地址和货位读取 token。
# 填了之后，加拣货条目时不用手工填楼层——系统按款号自动从图库带出来。
# 没填就是手工填，不影响别的功能。
GALLERY_URL=https://textil134-stock-marker.yedeen1987.workers.dev
GALLERY_TOKEN=
