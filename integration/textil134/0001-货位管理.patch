+async function styleLocationsApi(request, env) {
+  const token = String(env.LOCATION_TOKEN || '');
+  if (token.length < 24) return json({error:'货位接口未启用'}, 503);
+  const given = enc.encode(String(request.headers.get('Authorization') || ''));
+  const expected = enc.encode(`Bearer ${token}`);
+  if (given.length !== expected.length || !crypto.subtle.timingSafeEqual(given, expected)) return json({error:'无权限'}, 401);
