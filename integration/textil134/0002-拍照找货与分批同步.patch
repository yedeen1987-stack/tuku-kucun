+// 发送：把客户照片一张张传给拿货小程序拿 photo_key，再建单。
+// 照片传不过去就整单不发——宁可失败也不要建出一张没照片的拣货单，
+// 因为工人主要就是靠照片认布的。
+async function sendCart(env, user, customer) {
+  const base = String(env.PICKING_URL || '').trim().replace(/\/$/, '');
+  const token = String(env.PICKING_TOKEN || '');
+  if (!base || token.length < 24) throw new Error('还没有配置拿货小程序的地址或 token');
+
+  const items = await cartItems(env, user.id);
+  if (!items.length) throw new Error('拣货篮是空的');
+
+  const payload = [];
+  for (const row of items) {
+    let photoKey = '';
+    if (row.photo_key) {
+      const object = await env.IMAGES.get(row.photo_key);
+      if (!object) throw new Error(`照片不见了：${row.code}`);
+      const res = await fetch(`${base}/api/photos`, {
+        method:'POST',
+        headers:{'Authorization':`Bearer ${token}`,
+                 'Content-Type':object.httpMetadata?.contentType || 'image/jpeg'},
+        body: await object.arrayBuffer()
+      });
+      if (!res.ok) throw new Error(`照片上传失败 HTTP ${res.status}（${row.code}）`);
+      photoKey = (await res.json())?.photo_key || '';
+    }
+    payload.push({style:row.code, color:row.color, qty:row.qty,
+                  floor:row.place?.floor || '', spot:row.place?.side || '',
+                  note:row.note, photo_key:photoKey});
+  }
+
+  const res = await fetch(`${base}/api/import`, {
+    method:'PUT',
+    headers:{'Authorization':`Bearer ${token}`, 'Content-Type':'application/json'},
+    body: JSON.stringify({uuid: crypto.randomUUID(), customer_label: customer, items: payload})
+  });
+  if (!res.ok) throw new Error(`建单失败 HTTP ${res.status}：${(await res.text()).slice(0, 200)}`);
+  const result = await res.json();
+  await run(env, 'DELETE FROM pick_cart_item WHERE user_id=?', user.id);
+  return result;
+}
