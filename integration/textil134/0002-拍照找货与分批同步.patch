+// 拍照找货页 / 拣货篮页的卷数加减。
+// 客人常常要 2 卷 3 卷，所以点 − ＋ 就行，不用弹键盘；
+// 中间的数字也能直接打，应付偶尔要 20 卷的情况。
+(function () {
+  'use strict';
+  document.addEventListener('click', function (event) {
+    var step = event.target.closest('[data-qty-step]');
+    if (!step) return;
+    event.preventDefault();
+    var input = step.parentNode.querySelector('.qty-input');
+    if (!input) return;
+    var value = Number(String(input.value).replace(',', '.'));
+    if (!isFinite(value) || value <= 0) value = 1;
+    input.value = Math.max(1, Math.round((value + Number(step.dataset.qtyStep)) * 1000) / 1000);
+  });
+})();
