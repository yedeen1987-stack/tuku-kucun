+// 分批库存同步。
+//
+// 旧做法是一次 PUT 全表，超过 1000 条 Worker 直接 400 拒收，
+// 而销售软件那边只把错误写进日志——结果就是客户看到的缺货标记
+// 会在某一天悄悄停止更新，而且没人知道。这里改掉那个隐患。
+//
+// 新做法：
+//   seq=0 开始一次同步 → 每批写进暂存表 → final=true 时一次性切换到正式表
+// 客户永远看到的是完整的上一次结果，不会看到同步到一半的状态。
+// 每次同步的结果（成功/失败/条数/错误）记在 stock_sync_state，
+// 后台 /admin/stock-sync 能看到，失败不会没声音。
+//
+// 兼容旧版销售软件：不带 syncId 的请求当成「一批就是全部」处理。
+
+const SYNC_BATCH_LIMIT = 1000;
+
+async function syncState(env) {
+  return await first(env, 'SELECT * FROM stock_sync_state WHERE id=1');
+}
+
+async function writeSyncState(env, fields) {
+  const current = await syncState(env) || {};
+  const merged = {
+    sync_id: current.sync_id ?? null, status: current.status ?? 'idle',
+    batches: current.batches ?? 0, items: current.items ?? 0,
+    started_at: current.started_at ?? null, finished_at: current.finished_at ?? null,
+    last_ok_at: current.last_ok_at ?? null, last_ok_items: current.last_ok_items ?? 0,
+    last_error: current.last_error ?? '', ...fields
+  };
+  await run(env, `INSERT INTO stock_sync_state
+    (id,sync_id,status,batches,items,started_at,finished_at,last_ok_at,last_ok_items,last_error)
+    VALUES(1,?,?,?,?,?,?,?,?,?)
+    ON CONFLICT(id) DO UPDATE SET sync_id=excluded.sync_id,status=excluded.status,batches=excluded.batches,
+      items=excluded.items,started_at=excluded.started_at,finished_at=excluded.finished_at,
+      last_ok_at=excluded.last_ok_at,last_ok_items=excluded.last_ok_items,last_error=excluded.last_error`,
+    merged.sync_id, merged.status, merged.batches, merged.items, merged.started_at,
+    merged.finished_at, merged.last_ok_at, merged.last_ok_items, String(merged.last_error).slice(0, 500));
+  return merged;
+}
